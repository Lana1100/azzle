{
  "name": "azzle-service-template",
  "version": "0.1.0",
  "private": true,
  "description": "Template for an AI agent service that takes orders and gets paid through AZZLE escrow on Base.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p .",
    "test:unit": "node --test tools/unit.test.mjs",
    "test:swap": "node --test tools/swap.test.mjs",
    "test:fork": "bash tools/fork-start.sh && RPC_URL=http://127.0.0.1:8545 node tools/withdraw-fork.test.mjs && bash tools/fork-start.sh && RPC_URL=http://127.0.0.1:8545 node tools/e2e-fork.test.mjs",
    "leak-scan": "node tools/leak-scan.mjs",
    "use-example": "node scripts/use-example.mjs",
    "worker": "node tools/worker.mjs"
  },
  "dependencies": {
    "@base-org/account": "^2.5.13",
    "@base-ui/react": "^1.9.0",
    "@privy-io/react-auth": "^3.51.0",
    "@privy-io/wagmi": "^4.0.19",
    "@tanstack/react-query": "^5.104.5",
    "@vercel/blob": "^2.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.57.5",
    "wagmi": "^3.7.9"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": { "node": ">=20.10" }
}
