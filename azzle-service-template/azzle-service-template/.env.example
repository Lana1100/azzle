# Copy to .env.local (dev) or set in Vercel → Project → Settings → Environment Variables.
# Nothing here is a real value. Never commit a filled-in copy.

# --- Public (shipped to the browser) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000        # canonical URL, used in scopes, emails and metadata
NEXT_PUBLIC_PRIVY_APP_ID=                         # Privy app id (email sign-in + embedded wallet). Required for checkout.
NEXT_PUBLIC_PRIVY_SPONSOR=                        # "1" only if you enabled gas sponsorship for Base in the Privy dashboard
NEXT_PUBLIC_RPC_URL=                              # optional Base RPC for the browser (default: public mainnet.base.org)
NEXT_PUBLIC_WORKER_ADDRESS=                       # public address of the agent wallet that claims tasks (shown in footer/ops)
NEXT_PUBLIC_CONTACT_EMAIL=                        # optional support address shown in the footer

# --- Server ---
OPS_TOKEN=                                        # long random string; guards /api/ops/* and the /ops dashboard (openssl rand -hex 32)
CRON_SECRET=                                      # Vercel sends it to /api/cron/sync; required in production
RPC_URL=                                          # optional server-side Base RPC (default: public mainnet.base.org)
ORDER_RATE_LIMIT=                                 # optional: max new orders per IP per hour per instance (default 20, in-memory)
BRIEF_USER_AGENT=                                 # optional UA for fetching the customer's link
GITHUB_TOKEN=                                     # optional, read-only token: raises GitHub API limits for repo briefs

# --- Storage: local (default) | blob | s3 ---
STORAGE_DRIVER=                                   # empty = blob if BLOB_READ_WRITE_TOKEN is set, else local
DATA_DIR=                                         # local driver directory (default ./data). Not persistent on Vercel!
BLOB_READ_WRITE_TOKEN=                            # Vercel Blob (private store) token; Vercel sets it when you connect a store
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=                                      # e.g. Cloudflare R2 endpoint; empty for AWS
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# --- Notifications (all optional; without any, events are only logged) ---
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=                            # HMAC-SHA256 signature in x-notify-signature
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_PROVIDER=                            # resend | formsubmit
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
NOTIFY_FORMSUBMIT_ID=

# --- Previews (file deliverables, worker machine) ---
WATERMARK_FONT=                                   # optional .ttf for ffmpeg drawtext (default DejaVuSans-Bold)

# --- Worker CLI only (your machine, NEVER on Vercel) ---
WORKER_KEY_FILE=                                  # path to a JSON file {address, privateKey} with mode 600. No default.
SITE_URL=                                         # the deployed site the CLI talks to
